# Metered TURN Server credentials (KEEP STRICTLY SERVER-SIDE)
METERED_DOMAIN=your-app.metered.live
METERED_API_KEY=your_metered_secret_api_key
# Optional TURN region (e.g., global, us_east, europe)
METERED_REGION=global

# ImgBB Server-Side Upload API Key (optional proxy route /api/upload-image)
IMGBB_API_KEY=your_imgbb_api_key

# Port for standalone Express deployment (Cloud Run / Railway / Render / VPS)
PORT=3001

# Firebase Admin project ID (matches google-services.json project_id)
FIREBASE_PROJECT_ID=gen-lang-client-0631544834
