# TURN_BACKEND_URL: Optional HTTPS URL of your deployed Connect Live backend
# (e.g., https://your-turn-backend.run.app/api/turn-credentials).
# Never place METERED_API_KEY in this client file; keep it strictly on the backend.
TURN_BACKEND_URL=UNSET

# IMGBB_API_KEY: API key for uploading profile photos, chat images, and custom chat wallpapers via ImgBB.
# Configure this in the AI Studio Secrets panel (or on your Node backend in /backend).
IMGBB_API_KEY=UNSET

# CLOUDINARY_CLOUD_NAME & CLOUDINARY_UPLOAD_PRESET: For uploading and transferring chat/feed videos via Cloudinary.
# Configure these in the AI Studio Secrets panel or inside App Settings -> Media, ImgBB & Cloudinary.
CLOUDINARY_CLOUD_NAME=UNSET
CLOUDINARY_UPLOAD_PRESET=UNSET
